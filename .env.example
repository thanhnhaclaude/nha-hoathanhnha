# Kết nối MySQL (hPanel > Databases > MySQL Databases)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"
# Hoặc khai báo tách riêng (khuyên dùng trên Hostinger, thay cho DATABASE_URL):
# DB_HOST="localhost"
# DB_PORT="3306"
# DB_USER=""
# DB_PASSWORD=""
# DB_NAME=""

# Địa chỉ website (dùng cho SEO, sitemap)
NEXT_PUBLIC_SITE_URL="https://hoathanhnha.com"

# Đăng nhập trang quản trị /admin
ADMIN_USERNAME="admin"
# Tạo bằng lệnh: npm run hash-password -- "mat-khau-cua-ban" (kết quả dạng base64)
ADMIN_PASSWORD_HASH=""
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: openssl rand -hex 32
AUTH_SECRET=""

# Thông tin nhận chuyển khoản VietQR (mã ngân hàng theo https://api.vietqr.io/v2/banks, vd: VCB, TCB, MB, ACB)
VIETQR_BANK_ID="VCB"
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME="HOA TUOI THANH NHA"

# Phí giao hàng khi đơn dưới ngưỡng miễn phí (VND)
SHIPPING_FEE="30000"
FREE_SHIPPING_THRESHOLD="500000"

# Thư mục lưu ảnh tải lên từ trang quản trị (nên đặt ngoài thư mục code trên Hostinger)
# UPLOAD_DIR="/home/USER/uploads-hoathanhnha"

# Tự xác nhận chuyển khoản qua SePay (my.sepay.vn > Webhooks, chứng thực "API Key")
# URL webhook: https://hoathanhnha.com/api/sepay/webhook/   (có dấu "/" cuối)
SEPAY_API_KEY=""

# Email báo đơn (hPanel > Emails: tạo hộp thư, vd. donhang@hoathanhnha.com)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Hộp thư nhận thông báo đơn mới (mặc định = SMTP_USER)
SHOP_EMAIL=""

# Tiền tố mã đơn (khác nhau giữa các website dùng chung tài khoản ngân hàng; shophoathanhnha.com dùng TN)
ORDER_CODE_PREFIX="HN"

# Google (mặc định đã là mã của hoathanhnha.com chép từ website cũ; đặt "" để tắt)
# NEXT_PUBLIC_GA_ID="G-48L4JHB0VM"
# Mã xác minh Search Console / Merchant Center, cách nhau bằng dấu phẩy
# GOOGLE_SITE_VERIFICATION="0BL41Q2-kGGdFLnpWpfs2piKKesoA-i-M_zwugBOqI4"
